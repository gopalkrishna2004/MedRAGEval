# Copy to .env (gitignored). OPENROUTER_API_KEY is used by `medrageval extract`, `generate` and the `eval` judge.
OPENROUTER_API_KEY=
# Optional: only when the vLLM servers for `medrageval eval` run with --api-key.
VLLM_API_KEY=
# Optional: the answering server when it is not on this machine, e.g. http://<gpu-host>:8003/v1 (overrides llm.base_url).
VLLM_BASE_URL=
# Optional: the application's Postgres when it is not on port 5433, e.g. postgresql://localhost:5432/medrag (overrides store.dsn).
MEDRAG_DSN=
